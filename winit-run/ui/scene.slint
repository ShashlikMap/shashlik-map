import {
    Slider,
    GroupBox,
    HorizontalBox,
    VerticalBox,
    GridBox,
} from "std-widgets.slint";

export component AppKiol inherits Window {
    in property <image> texture <=> image.source;
    out property <int> requested-texture-width: image.width / 1phx;
    out property <int> requested-texture-height: image.height / 1phx;
    callback pointer_event(PointerEvent, float, float);
    callback vert_scroll(float);
    title: "ShashlikMap";

    HorizontalBox {
        image := Image {
            preferred-width: 1600phx;
            preferred-height: 1200phx;
//            min-width: 64px;
//            min-height: 64px;
//            width: 100%;
            height: 100%;

            image_overlay := TouchArea {
                width: parent.width;
                height: parent.height;
                pointer-event(event) => {
                    pointer_event(event, self.mouse-x / 1phx, self.mouse-y / 1phx)
                }
                scroll-event(event) => {
                    vert_scroll(event.delta-y / 1phx);
                    accept;
                }
            }
        }

        VerticalBox {
            width: 200phx;
            height: 100%;

            Text {
                text: "This text is rendered using Slint. The rotating cube below is rendered into an WGPU texture.";
                wrap: word-wrap;
            }
        }
    }
}
