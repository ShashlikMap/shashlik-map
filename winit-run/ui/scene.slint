import {
    Slider,
    GroupBox,
    HorizontalBox,
    VerticalBox,
    GridBox,
    CheckBox,
    Button,
    ComboBox,
} from "std-widgets.slint";

export enum Feature {
    SSAO,
    Shadows,
    MeshShader,
}

export enum Action {
    DmOffice,
    Route,
    ClearRoute,
    KML,
}

export struct Scale {
    value: float,
    x: float,
    y: float,
}

export struct PanState {
    pressed: bool,
    x: float,
    y: float,
}

export component ShashlikUI inherits Window {
    in property <[string]> preview_type_items;
    in property <[string]> tiles_type_items;
    in property <int> screen-width;
    in property <int> screen-height;
    in property <image> texture <=> image.source;
    out property <int> requested-texture-width: image.width / 1phx;
    out property <int> requested-texture-height: image.height / 1phx;
    out property <Scale> current-scale;
    out property <PanState> current-pan-state;
    in-out property <string> fps_text: "";
    private property <bool> panel_controls: false;
    private property <bool> extended_controls: true;
    property <bool> pressed: false;
    callback vert_scroll(float);
    callback follow_mode(bool);
    callback preview_type(string);
    callback tiles_type(string);
    callback feature_enabled(Feature, bool);
    callback btn_click(Action, int);
    callback key-pressed(KeyEvent);
    callback key-released(KeyEvent);
    title: "ShashlikMap";
    width: screen-width * 1phx;
    height: screen-height * 1phx;

    forward-focus: key-handler;
    key-handler := FocusScope {
        init => { self.focus(); }

        key-pressed(event) => {
            root.key-pressed(event);
            accept
        }
        key-released(event) => {
            root.key-released(event);
            accept
        }
    }

    HorizontalBox {
        padding: 0;
        image := Image {
            width: 100%;
            height: 100%;
            TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        pressed = true;
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        pressed = false;
                    }
                    current-pan-state = { pressed: pressed, x: self.mouse-x / 1phx, y: self.mouse-y / 1phx };
                }
                scroll-event(event) => {
                    vert_scroll(event.delta-y / 1phx);
                    accept;
                }
            }

            ScaleRotateGestureHandler {
                started => {
                    current-scale = { value: 0.0, x: 0.0, y: 0.0 };
                }
                ended => {
                    current-scale = { value: 0.0, x: 0.0, y: 0.0 };
                }
                updated => {
                    current-scale = { value: self.scale, x: self.center.x / 1phx, y: self.center.y / 1phx };
                }
            }
        }
    }

    HorizontalLayout {
        height: 100%;
        alignment: end;
        vertical-stretch: 0;
        cross-axis-alignment: center;
        padding-right: 16px;
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: self.width / 2;

            background: touch-area.pressed ? #3a3a3c : #1c1c1e;
            border-width: 1px;
            border-color: #48484a;

            animate background { duration: 100ms; }

            Image {
                source: @image-url("ic-settings.svg");
                width: 24px;
                height: 24px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: #ffffff;
            }

            touch-area := TouchArea {
                clicked => {
                    panel_controls = !panel_controls;
                }
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        width: 320px;
        height: layout.preferred-height + 48px;
        background: #1c1c1e;
        border-radius: 8px;
        border-width: 1px;
        border-color: #48484a;

        opacity: panel_controls ? 90% : 0%;
        visible: self.opacity > 0.0;

        animate opacity {
            duration: 100ms;
            easing: ease-in-out;
        }

        layout := VerticalBox {
            vertical-stretch: 0;
            padding: 16px;

            CheckBox {
                text: "Follow mode";
                height: 24px;
                checked: true;
                toggled => {
                    panel_controls = false;
                    follow_mode(self.checked)
                }
            }

            Button {
                text: "DM Office";
                height: 48px;
                clicked => {
                    panel_controls = false;
                    btn_click(Action.DmOffice, cost.current-index)
                }
            }

            cost := ComboBox {
                height: 48px;
                model: ["pedestrian", "auto", "motorbike"];
                current-index: 0;
            }

            tiles_types := ComboBox {
                height: 48px;
                model: tiles_type_items;
                current-index: 0;
                selected(value) => {
                    tiles_type(value)
                }
            }

            Button {
                text: "Route";
                height: 48px;
                clicked => {
                    panel_controls = false;
                    btn_click(Action.Route, cost.current-index)
                }
            }

            Button {
                text: "ClearRoute";
                height: 48px;
                clicked => {
                    panel_controls = false;
                    btn_click(Action.ClearRoute, cost.current-index)
                }
            }

            CheckBox {
                text: "Shadows";
                height: 24px;
                checked: true;
                toggled => {
                    feature_enabled(Feature.Shadows, self.checked)
                }
            }

            CheckBox {
                text: "MeshShader";
                height: 24px;
                checked: false;
                toggled => {
                    feature_enabled(Feature.MeshShader, self.checked)
                }
            }

            if extended_controls: VerticalLayout {
//                Button {
//                    text: "Open KML";
//                    height: 48px;
//                    clicked => {
//                        btn_click(Action.KML, cost.current-index)
//                    }
//                }

                CheckBox {
                    text: "SSAO";
                    height: 24px;
                    checked: false;
                    toggled => {
                        feature_enabled(Feature.SSAO, self.checked)
                    }
                }

                Rectangle {
                    height: 16px;
                }

                preview_types := ComboBox {
                    height: 48px;
                    model: preview_type_items;
                    current-index: 0;
                    selected(value) => {
                        preview_type(value)
                    }
                }
            }
        }
    }

    Text {
        text: root.fps_text;
        color: red;
        font-size: 24px;
        font-weight: 700;
        x: 20px;
        y: 20px;
    }
}
